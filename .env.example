# Browser-visible FastAPI base URL.
NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# Docker Compose PostgreSQL/TimescaleDB development values only.
POSTGRES_DB=quantlens
POSTGRES_USER=quantlens
POSTGRES_PASSWORD=quantlens

# Replace with distinct random values of at least 32 characters outside local development.
JWT_SECRET=replace-with-a-32-character-development-secret
REFRESH_TOKEN_HMAC_KEY=replace-with-a-separate-32-character-development-secret

# AI Analyst / LLM Provider Configuration
# Using Google Gemini via OpenAI-compatible endpoint.
# Get key at: https://aistudio.google.com/apikey
AI_ANALYST_PROVIDER=deterministic
AI_ANALYST_API_KEY=
AI_ANALYST_BASE_URL=
AI_ANALYST_MODEL=gpt-4o-mini
AI_ANALYST_TIMEOUT_SECONDS=10.0

# Market Data Provider (see ADR-005-yfinance-provider.md).
# Backfill command: `python -m scripts.backfill_market_data` from apps/quant-api/.
MARKET_DATA_PROVIDER=yfinance
YFINANCE_ENABLED=true
YFINANCE_REQUEST_TIMEOUT_SECONDS=15.0
YFINANCE_DEFAULT_PERIOD=2y
YFINANCE_SYMBOL_SUFFIX=.JK
YFINANCE_PROXY=
YFINANCE_SYMBOLS=BBCA,BMRI,BBRI,TLKM,ASII,UNVR,INDF,ICBP,KLBF,SMGR,BNBR,BUMI,UNSP,ELTY,ENRG,BTEL,DEWA,BRMS,VIVA,MDIA,JGLE,ALII,UNTR,PAMA,DOID,PTBA,ADRO,HRUM,GEMS,BYAN,MBAP,KKGI,BRPT,BREN,TPIA,CUAN,PTRO,GZCO,CDIA,TINS,NICK,CITA,RMKE,SMMT,ARCI,BRNA,PWON,BSDE,CTRA,SMRA,APLN,KIJA,ELSA,RAJA,GMFI,JIHD,BUKA,EMTK,DCII,TFAS,EDGE,MTDL,WEGE,TOTL,TRUE,BUVA,DSSA,IATA,KOTA,BULL,INET,PADA,SLIS,VKTR,ERAA,IMPC,GRPH,HUMI
